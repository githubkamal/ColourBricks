{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "Cors": {
    "FrontendOrigins": [ "http://localhost:3000" ]
  },
  "Diagnostics": {
    "Enabled": false
  },
  "Jwt": {
    "Issuer": "colourbricks",
    "Audience": "colourbricks",
    "SigningKey": "",
    "AccessTokenMinutes": 15
  },
  "Auth": {
    "RefreshTokenDays": 14,
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15,
    "CookieSecure": true
  },
  "AllowedHosts": "*"
}
