# Install: sudo cp deploy/systemd/colourbricks-web.service /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now colourbricks-web
# Port 3003 is this project's pick on a shared box that already had 3000-3002
# taken by other apps — change -p (and the matching Nginx proxy_pass) if you're
# deploying to a dedicated box or 3003 is also taken there.
[Unit]
Description=Colour Bricks Web (Next.js)
After=network.target colourbricks-api.service

[Service]
Type=simple
WorkingDirectory=/opt/colourbricks/web/current
ExecStart=/usr/bin/npm run start -- -p 3003 -H 127.0.0.1
Restart=on-failure
RestartSec=5
User=colourbricks
Group=colourbricks
EnvironmentFile=/opt/colourbricks/shared/web.env
SyslogIdentifier=colourbricks-web

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/colourbricks/web/current/.next/cache

[Install]
WantedBy=multi-user.target
